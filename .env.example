# Database Connection (MongoDB Atlas Free M0 Cluster or Local)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/new_rang_rangoli?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/new_rang_rangoli

# Authentication Secret
JWT_SECRET=super_secret_festive_rang_rangoli_key_2026

# Razorpay Payment Gateway Credentials (from https://dashboard.razorpay.com/app/keys)
# For development and testing, you can use Razorpay Test Key ID and Secret
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Server Port
PORT=5000

# WhatsApp Business Gateway Settings
# Business Phone for sending order notifications & delivery OTP
WHATSAPP_BUSINESS_PHONE=+917057617451

# Meta WhatsApp Cloud API Credentials (Optional - Meta Developer App)
WHATSAPP_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id

# Twilio WhatsApp Credentials (Optional alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
